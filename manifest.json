
{
  "manifest_version": 3,
  "name": "LLM-Notes",
  "version": "0.2",
  "description": "LLM Notes: Save, organize, and build how-to guides from your LLM chats.",
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.mistral.ai/*"],
      "js": ["dist/mistral_entry.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dist/chatgpt_handler.js"],
      "run_at": "document_end"
    }
  ]
}
