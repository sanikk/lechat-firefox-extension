
{
  "manifest_version": 3,
  "name": "LLM-Notes",
  "version": "0.2",
  "description": "LLM Notes: Save, organize, and build how-to guides from your LLM chats.",
  "content_scripts": [
    {
      "matches": [
        "https://chat.mistral.ai/chat/*",
        "https://chatgpt.com/*"
      ],
      "js": ["dist/bundle.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "dist/background_script.js"
    ]
  },
  "permissions": [
    "tabs",
    "activeTab"
  ]
}
